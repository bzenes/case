# Copy to .env for local dev.
#
# No Docker/Postgres install is available in this dev environment, so local
# dev and tests run against `embedded-postgres` (a real Postgres binary,
# downloaded on `pnpm install`, no Docker/admin rights needed) instead of the
# docker-compose.yml PLAN.md suggests. See NOTES.md "Assumptions" for why.
#
# For a real deployment, set USE_EMBEDDED_PG=false and point DATABASE_URL at
# a real Postgres instance instead.
USE_EMBEDDED_PG=true
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/app

# Used to HMAC-sign the dev session cookie. Any string works locally; treat
# it as a real secret in any shared deployment.
SESSION_SECRET=dev-only-insecure-secret-change-me

# --- Production (e.g. Vercel + Vercel Postgres/Neon) ---
# Do NOT set this to "true" outside local dev - embedded-postgres spawns a
# real Postgres process, which doesn't work in a serverless environment.
# Just omit USE_EMBEDDED_PG entirely in production; unset is already a no-op.
#
# DATABASE_URL: use the POOLED connection string your Postgres provider
# gives you (Vercel Postgres/Neon integration writes one to your project's
# env vars automatically, already named DATABASE_URL) - serverless functions
# open many short-lived connections, so pooled avoids exhausting
# max_connections. Must include sslmode=require:
#   postgresql://<user>:<password>@<pooler-host>/<database>?sslmode=require
#
# Migrations (`pnpm db:migrate`) aren't run automatically on deploy - run
# them yourself, once, against the UNPOOLED connection string instead
# (same provider, usually named DATABASE_URL_UNPOOLED / POSTGRES_URL_NON_POOLING):
#   DATABASE_URL="<unpooled connection string>" pnpm db:migrate
#
# SESSION_SECRET: generate a real one, e.g. `openssl rand -hex 32` - never
# reuse the dev placeholder above.
